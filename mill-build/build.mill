import mill.*
import mill.meta.MillBuildRootModule
import mill.scalalib.*

object `package` extends MillBuildRootModule {

  override def mvnDeps = Seq(
    mvn"io.get-coursier:coursier-launcher_2.13:2.1.7",
    mvn"io.get-coursier:interface:1.0.29-M1",
    mvn"commons-io:commons-io:2.16.0",
    mvn"com.softwaremill.sttp.client4::core:4.0.9"
  )

  // mill-native-image is built from the mill-native-image submodule rather than pulled from
  // Maven Central, so that it's compiled against the Mill (and coursier) this build runs on
  def millNativeImageSources = Task.Sources(
    moduleDir / "mill-native-image/plugin/src",
    moduleDir / "mill-native-image/plugin/src-mill1"
  )
  override def sources = Task {
    super.sources() ++ millNativeImageSources()
  }
}
