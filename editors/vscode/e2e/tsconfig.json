{
  // Only used for type-checking (pnpm typecheck): Playwright and Node run the .ts files directly
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["lib", "tests", "dev", "playwright.config.ts"]
}
